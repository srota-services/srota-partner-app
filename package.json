{
  "name": "Srota Partner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Srota Partner app",
  "author": "Srota",
  "license": "MIT",
  "engines": {
    "node": "26.4.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "check:runtime": "node ../scripts/check-runtime.mjs",
    "preinstall": "npm run check:runtime --silent",
    "dev": "npm run check:runtime --silent && vite --mode development",
    "start:development": "npm run check:runtime --silent && vite --mode development",
    "start:testing": "npm run check:runtime --silent && vite --mode testing",
    "start:staging": "npm run check:runtime --silent && vite --mode staging",
    "start:production": "npm run check:runtime --silent && vite --mode production",
    "build": "npm run check:runtime --silent && tsc && vite build --mode production",
    "build:development": "npm run check:runtime --silent && tsc && vite build --mode development",
    "build:testing": "npm run check:runtime --silent && tsc && vite build --mode testing",
    "build:staging": "npm run check:runtime --silent && tsc && vite build --mode staging",
    "build:production": "npm run check:runtime --silent && tsc && vite build --mode production",
    "serve:development": "npm run check:runtime --silent && npm run build:development && vite preview --mode development --host",
    "serve:testing": "npm run check:runtime --silent && npm run build:testing && vite preview --mode testing --host",
    "serve:staging": "npm run check:runtime --silent && npm run build:staging && vite preview --mode staging --host",
    "serve:production": "npm run check:runtime --silent && npm run build:production && vite preview --mode production --host",
    "preview": "npm run check:runtime --silent && npm run serve:production",
    "lint": "npm run check:runtime --silent && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "npm run check:runtime --silent && vitest --mode testing",
    "test:ui": "npm run check:runtime --silent && vitest --ui --mode testing",
    "test:coverage": "npm run check:runtime --silent && vitest --coverage --mode testing"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@reduxjs/toolkit": "^2.10.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/react-datepicker": "^6.2.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.17.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.9.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.21.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "baseline-browser-mapping": "^2.10.35",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
